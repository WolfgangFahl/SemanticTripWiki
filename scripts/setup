#!/bin/bash
# WF 2026-11-08
# setup a Semantic MediaWiki trip documentation wiki
# one line install:
#   curl -fsSL https://raw.githubusercontent.com/WolfgangFahl/SemanticTripWiki/main/scripts/setup | bash

#
# copy of $HOME/source/bash/mp/bash_messages WF 2025-11-20
# so that this script works standalone via curl
#
# ANSI colors
blue='\033[0;34m'
red='\033[0;31m'
green='\033[0;32m'
yellow='\033[1;33m'
endColor='\033[0m'

#
# Display a colored message
# Args:
#   $1: color code
#   $2: message text
#   $3: optional file descriptor (default 1 for stdout)
#
color_msg() {
  local l_color="$1"
  local l_msg="$2"
  local l_fd="${3:-1}"
  echo -e "${l_color}${l_msg}${endColor}" >&"$l_fd"
}

#
# Display an error message (stderr) and optionally exit
# Args:
#   $1: error message
#   $2: exit code (optional, 0 means don't exit, default 1)
#
error() {
  local l_msg="$1"
  local l_exitcode="${2:-1}"
  color_msg "$red" "✗ Error: $l_msg" 2
  if [ "$l_exitcode" -ne 0 ]; then
    exit "$l_exitcode"
  fi
}

#
# Display a success message
# Args:
#   $1: success message
#
success() {
  local l_msg="$1"
  color_msg "$green" "✓ $l_msg"
}

#
# Display an action/info message
# Args:
#   $1: action message
#
action() {
  local l_msg="$1"
  color_msg "$blue" "➜ $l_msg"
}

#
# Display a warning message
# Args:
#   $1: warning message
#
warn() {
  local l_msg="$1"
  color_msg "$yellow" "⚠ $l_msg"
}

#
# Ensure a program is available; install it if not, using per-OS package manager
# (MacPorts on Darwin, apt on Linux).
# Args:
#   $1: l_prog          - the program that must be available (checked via which)
#   $2: l_linuxpackage  - the apt package name on Linux
#   $3: l_macospackage  - the MacPorts package name on Darwin
# Env:
#   AUTOINSTALL_HINT_ONLY=1  - do NOT install; print the exact install command
#                              and error out (used by scripts with --init opt-in)
#
autoinstall() {
  local l_prog="$1"
  local l_linuxpackage="$2"
  local l_macospackage="$3"
  local l_os
  l_os=$(uname)
  if command -v "$l_prog" >/dev/null 2>&1; then
    return 0
  fi
  local l_cmd
  case "$l_os" in
    Darwin) l_cmd="sudo port install -N $l_macospackage" ;;
    Linux)  l_cmd="sudo apt-get install -y $l_linuxpackage" ;;
    *)      error "$l_prog is not installed and $l_os is not supported for autoinstall" ;;
  esac
  if [ "${AUTOINSTALL_HINT_ONLY:-0}" = "1" ]; then
    warn "$l_prog is not installed — install with: $l_cmd"
    return 1
  fi
  action "installing $l_prog: $l_cmd"
  eval "$l_cmd"
}
# end of copy of bash_messages

# the trip wiki - per the Bootstrap of https://ebike2026.bitplan.com/wiki/Bootstrap
CANASTA_DIR="${CANASTA_DIR:-$HOME/canasta}"
TRIPWIKI_ID="${TRIPWIKI_ID:-tripwiki}"
TRIPWIKI_HOST="${TRIPWIKI_HOST:-localhost}"
HTTP_PORT="${HTTP_PORT:-8080}"
HTTPS_PORT="${HTTPS_PORT:-8443}"
# content of the wiki: wikibackup (restore the pages of the repository) or ypgen (generate them from the sidif masters)
TRIPWIKI_CONTENT="${TRIPWIKI_CONTENT:-wikibackup}"
REPO_URL="https://github.com/WolfgangFahl/SemanticTripWiki"
REPO_DIR="${REPO_DIR:-$HOME/source/python/SemanticTripWiki}"
# pipx installs the python tools here
export PATH="$HOME/.local/bin:$PATH"
EXTENSIONS="ParserFunctions,Variables,PageForms,SemanticResultFormats,Maps,HeaderTabs,AdminLinks,Mermaid,Scribunto,MagicNoCache"

#
# usage - show help
#
usage() {
  cat << EOF
usage: setup [-h|--help]
   without arguments: check the prerequisites - macOS or Linux, bash, curl, docker - and offer how to install docker if missing,
                      then install the Canasta CLI, create the Canasta instance and enable Semantic MediaWiki
   environment: CANASTA_DIR (default ~/canasta), TRIPWIKI_ID (default tripwiki), TRIPWIKI_HOST (default localhost),
                HTTP_PORT and HTTPS_PORT used when 80 or 443 are in use (default 8080 and 8443)
   -h|--help: show help
EOF
  exit 1
}

#
# ask - ask a yes/no question on the terminal, also when the script is piped via curl
#   $1: l_question the question to ask
#
ask() {
  local l_question="$1"
  local l_answer
  # no terminal - e.g. in CI - counts as no
  { read -r -p "$l_question [y/N] " l_answer < /dev/tty; } 2>/dev/null || return 1
  [[ "$l_answer" == "y" || "$l_answer" == "Y" ]]
}

#
# check_compose - check docker compose, which Canasta needs to start its stack
#
check_compose() {
  if docker compose version >/dev/null 2>&1; then
    success "$(docker compose version | head -1) is installed"
    return 0
  fi
  warn "docker compose is missing - Canasta needs it to start the trip wiki"
  case "$(uname)" in
    Darwin)
      action "OrbStack and Docker Desktop include docker compose - update or reinstall your docker engine"
      ;;
    Linux)
      action "install with: sudo apt-get install -y docker-compose-v2"
      if ask "install docker compose now?"; then
        sudo apt-get install -y docker-compose-v2 || error "docker compose installation failed"
        success "docker compose installed"
        return 0
      fi
      ;;
  esac
  return 1
}

#
# check_docker - check docker, hint and offer to install it if missing
#
check_docker() {
  local l_os
  l_os=$(uname)
  if command -v docker >/dev/null 2>&1; then
    local l_info
    if l_info=$(docker info 2>&1); then
      success "docker $(docker --version | cut -d' ' -f3 | tr -d ',') is installed and running"
      check_compose
      return $?
    fi
    if [[ "$l_info" == *"permission denied"* ]]; then
      warn "docker is running but user $USER may not use it"
      action "run: sudo usermod -aG docker $USER"
      action "then log out, log in again and run this setup again"
    else
      warn "docker is installed but the docker engine is not running"
      case "$l_os" in
        Darwin) action "start OrbStack or Docker Desktop and run this setup again" ;;
        Linux)  action "run: sudo systemctl start docker - then run this setup again" ;;
      esac
    fi
    return 1
  fi
  warn "docker is missing - the trip wiki runs as a Canasta instance in docker"
  case "$l_os" in
    Darwin)
      action "install a docker engine for macOS, e.g. OrbStack from https://orbstack.dev or Docker Desktop from https://www.docker.com/products/docker-desktop/"
      if ask "open the OrbStack download page now?"; then
        open "https://orbstack.dev/download"
      fi
      ;;
    Linux)
      action "install with: sudo apt-get install -y docker.io docker-compose-v2"
      if ask "install docker now?"; then
        sudo apt-get install -y docker.io docker-compose-v2 || error "docker installation failed"
        success "docker installed"
        return 0
      fi
      ;;
    *)
      error "$l_os is not supported - use macOS or Linux"
      ;;
  esac
  return 1
}

#
# check_prereqs - check the prerequisites: macOS or Linux, bash, curl and docker
#
check_prereqs() {
  local l_os
  l_os=$(uname)
  case "$l_os" in
    Darwin|Linux) success "$l_os is supported" ;;
    *)            error "$l_os is not supported - use macOS or Linux" ;;
  esac
  success "bash $BASH_VERSION"
  command -v curl >/dev/null 2>&1 || error "curl is missing - install it with your package manager"
  success "curl is installed"
  check_docker
}

#
# install_canasta - install the Canasta CLI if missing
# see https://canasta.wiki/wiki/Help:Installation
#
install_canasta() {
  if command -v canasta >/dev/null 2>&1; then
    success "canasta $(canasta version 2>/dev/null | head -1) is installed"
    return 0
  fi
  action "installing the Canasta CLI from https://get.canasta.wiki"
  curl -fsSL https://get.canasta.wiki | bash || error "Canasta CLI installation failed"
  command -v canasta >/dev/null 2>&1 || error "canasta not found on PATH after installation"
  success "canasta installed"
}

#
# port_busy - check whether something listens on the given local port
#   $1: l_port the port to check
#
port_busy() {
  local l_port="$1"
  (echo > "/dev/tcp/127.0.0.1/$l_port") >/dev/null 2>&1
}

#
# free_port - echo the first free local port starting at the given one
#   $1: l_port the port to start with
#
free_port() {
  local l_port="$1"
  while port_busy "$l_port"; do
    l_port=$((l_port + 1))
  done
  echo "$l_port"
}

#
# create_instance - create the Canasta instance of the trip wiki if missing
# uses ports 80 and 443 if free, otherwise the first free ports from HTTP_PORT and HTTPS_PORT on
#
create_instance() {
  if [[ -d "$CANASTA_DIR/$TRIPWIKI_ID" ]]; then
    success "Canasta instance $TRIPWIKI_ID exists in $CANASTA_DIR/$TRIPWIKI_ID"
    if [[ "$TRIPWIKI_HOST" == "localhost" ]] && ! grep -q "^TLS_MODE=off" "$CANASTA_DIR/$TRIPWIKI_ID/.env"; then
      action "switching the local wiki $TRIPWIKI_ID to plain HTTP"
      canasta config set -i "$TRIPWIKI_ID" TLS_MODE=off || error "canasta config set TLS_MODE=off failed"
    fi
    return 0
  fi
  mkdir -p "$CANASTA_DIR" || error "can not create $CANASTA_DIR"
  local l_envfile="$CANASTA_DIR/$TRIPWIKI_ID.env"
  if port_busy 80 || port_busy 443; then
    HTTP_PORT=$(free_port "$HTTP_PORT")
    HTTPS_PORT=$(free_port "$HTTPS_PORT")
    warn "ports 80 or 443 are in use - the trip wiki gets ports $HTTP_PORT and $HTTPS_PORT"
  else
    HTTP_PORT=80
    HTTPS_PORT=443
  fi
  printf "HTTP_PORT=%s\nHTTPS_PORT=%s\n" "$HTTP_PORT" "$HTTPS_PORT" > "$l_envfile"
  action "creating Canasta instance $TRIPWIKI_ID at $TRIPWIKI_HOST port $HTTPS_PORT"
  # a local wiki is served over plain HTTP: the certificate of the Canasta edge CA is not trusted by the python tools
  local l_tls=""
  [[ "$TRIPWIKI_HOST" == "localhost" ]] && l_tls="--skip-tls"
  (cd "$CANASTA_DIR" && canasta create -i "$TRIPWIKI_ID" -w "$TRIPWIKI_ID" -n "$TRIPWIKI_HOST" -e "$l_envfile" $l_tls) || error "canasta create failed"
  success "Canasta instance $TRIPWIKI_ID created - the WikiSysop password is in $CANASTA_DIR/$TRIPWIKI_ID/admin-password_$TRIPWIKI_ID"
}

#
# enable_smw - Semantic MediaWiki and the extension set of the trip wiki
# the settings file comes first since the extension enable runs update.php
#
enable_smw() {
  local l_settings="$CANASTA_DIR/$TRIPWIKI_ID/config/settings/global/SemanticMediaWiki.php"
  if [[ -f "$l_settings" ]]; then
    success "Semantic MediaWiki is enabled"
    return 0
  fi
  action "enabling Semantic MediaWiki"
  mkdir -p "$(dirname "$l_settings")" || error "can not create $(dirname "$l_settings")"
  cat << EOF > "$l_settings"
<?php
wfLoadExtension( 'SemanticMediaWiki' );
enableSemantics( '$TRIPWIKI_HOST' );
EOF
  canasta extension enable "$EXTENSIONS" -i "$TRIPWIKI_ID" || error "enabling the extensions failed"
  canasta maintenance extension SemanticMediaWiki:rebuildData -i "$TRIPWIKI_ID" || error "SemanticMediaWiki rebuildData failed"
  success "Semantic MediaWiki and $EXTENSIONS enabled"
}

#
# get_repo - clone the repository or bring it up to date, it holds the sidif masters and the wikibackup pages
#
get_repo() {
  command -v git >/dev/null 2>&1 || error "git is missing - install it with your package manager"
  if [[ -d "$REPO_DIR/.git" ]]; then
    git -C "$REPO_DIR" pull -q --ff-only || error "git pull in $REPO_DIR failed"
    success "repository $REPO_DIR is up to date"
  else
    mkdir -p "$(dirname "$REPO_DIR")" || error "can not create $(dirname "$REPO_DIR")"
    git clone -q "$REPO_URL" "$REPO_DIR" || error "git clone of $REPO_URL failed"
    success "repository cloned to $REPO_DIR"
  fi
}

#
# install_python_tools - install wikiuser, wikirestore and ypgen with pipx if missing
#
install_python_tools() {
  if ! command -v pipx >/dev/null 2>&1; then
    warn "pipx is missing - it installs the python tools of the trip wiki"
    case "$(uname)" in
      Darwin) action "install pipx, e.g. with: sudo port install pipx or brew install pipx" ;;
      Linux)  action "install with: sudo apt-get install -y pipx" ;;
    esac
    exit 1
  fi
  command -v wikirestore >/dev/null 2>&1 || pipx install py-3rdparty-mediawiki || error "pipx install py-3rdparty-mediawiki failed"
  command -v ypgen >/dev/null 2>&1 || pipx install py-yprinciple-gen || error "pipx install py-yprinciple-gen failed"
  success "python tools wikiuser, wikirestore and ypgen are installed"
}

#
# register_wiki - make the wiki known to the python tools with the generated WikiSysop credentials
#
register_wiki() {
  local l_ini="$HOME/.mediawiki-japi/${USER}_${TRIPWIKI_ID}.ini"
  local l_dir="$CANASTA_DIR/$TRIPWIKI_ID"
  local l_url
  l_url=$(grep "^MW_SITE_SERVER=" "$l_dir/.env" | cut -d= -f2)
  [[ -n "$l_url" ]] || error "MW_SITE_SERVER missing in $l_dir/.env"
  # registered for the current url of the wiki - it changes e.g. with TLS_MODE
  if [[ -f "$l_ini" ]] && grep -q "$l_url" "$l_ini"; then
    success "wiki $TRIPWIKI_ID is registered for $l_url"
    return 0
  fi
  [[ -f "$l_dir/admin-password_$TRIPWIKI_ID" ]] || error "admin-password_$TRIPWIKI_ID missing in $l_dir"
  wikiuser -w "$TRIPWIKI_ID" -l "$l_url" -s /w -v "MediaWiki 1.43" -u WikiSysop \
    -p "$(cat "$l_dir/admin-password_$TRIPWIKI_ID")" --smw true -y >/dev/null || error "wikiuser registration failed"
  success "wiki $TRIPWIKI_ID registered for $l_url"
}

#
# drain_jobs - run the job queue of the wiki empty
# Semantic MediaWiki locks property pages while change propagation jobs are pending
#
drain_jobs() {
  action "running the job queue of $TRIPWIKI_ID"
  canasta maintenance script -i "$TRIPWIKI_ID" runJobs >/dev/null 2>&1 || error "runJobs failed"
  success "job queue of $TRIPWIKI_ID is empty"
}

#
# upload_images - upload the images of the wikibackup, existing files are kept
#
upload_images() {
  local l_out
  local l_rc
  action "uploading the images of $REPO_DIR/wikibackup/images"
  l_out=$(cd "$REPO_DIR/wikibackup/images" && wikiupload -t "$TRIPWIKI_ID" --files * 2>&1)
  l_rc=$?
  # an existing file is kept - that is the idempotent case, not an error
  l_out=$(echo "$l_out" | grep -v "already exists")
  if [[ $l_rc -ne 0 || "$l_out" == *"❌"* || "$l_out" == *"Exception"* ]]; then
    echo "$l_out" | grep -E "❌|Exception" >&2
    error "wikiupload failed"
  fi
  success "images uploaded"
}

#
# create_content - create the pages of the trip wiki from the repository
#
create_content() {
  local l_sidif
  case "$TRIPWIKI_CONTENT" in
    wikibackup)
      # a restart clears the property type cache of the web container and with it
      # stale change propagation locks of Semantic MediaWiki, see https://ebike2026.bitplan.com/wiki/Bootstrap
      action "restarting $TRIPWIKI_ID before the restore"
      canasta restart -i "$TRIPWIKI_ID" >/dev/null 2>&1 || error "canasta restart failed"
      drain_jobs
      action "restoring the pages of $REPO_DIR/wikibackup"
      local l_out
      local l_rc
      # all files of the backup path, see https://github.com/WolfgangFahl/py-3rdparty-mediawiki/issues/44
      # wikirestore exits with 0 on a failed login, so its output is checked
      l_out=$(wikirestore -t "$TRIPWIKI_ID" --backupPath "$REPO_DIR/wikibackup" 2>&1)
      l_rc=$?
      if [[ $l_rc -ne 0 || "$l_out" == *"❌"* || "$l_out" == *"Exception"* ]]; then
        echo "$l_out" | grep -E "❌|Exception" >&2
        error "wikirestore failed"
      fi
      upload_images
      ;;
    ypgen)
      for l_sidif in MetaModel TripContext; do
        action "generating $l_sidif with ypgen"
        ypgen --sidif "$REPO_DIR/sidif/$l_sidif.sidif" -ga --wikiId "$TRIPWIKI_ID" -nd || error "ypgen for $l_sidif failed"
      done
      ;;
    *)
      error "TRIPWIKI_CONTENT must be wikibackup or ypgen, not $TRIPWIKI_CONTENT"
      ;;
  esac
  drain_jobs
  success "content created via $TRIPWIKI_CONTENT"
}

#
# setup - set up the trip wiki
#
setup() {
  check_prereqs || exit 1
  install_canasta
  create_instance
  enable_smw
  get_repo
  install_python_tools
  register_wiki
  create_content
  local l_code
  local l_url
  l_url=$(grep "^MW_SITE_SERVER=" "$CANASTA_DIR/$TRIPWIKI_ID/.env" | cut -d= -f2)
  l_code=$(curl -sk -o /dev/null -w "%{http_code}" "$l_url/wiki/Main_Page")
  if [[ "$l_code" == "200" ]]; then
    success "the trip wiki answers at $l_url"
  else
    warn "$l_url/wiki/Main_Page answers $l_code - check with: canasta list"
  fi
}

# no arguments -> setup, as needed for the one line install via curl
[[ $# -eq 0 ]] && setup

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage ;;
    *)         usage ;;
  esac
  shift
done
